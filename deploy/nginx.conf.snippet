# Add this location block to your existing nginx server block for the
# domain/subdomain you're using for this project (e.g. inside the same
# server {} block as your other DAWS projects). Adjust the location path
# if you're not putting this dashboard at the domain root.
#
# Streamlit needs WebSocket upgrade headers -- without them the app loads
# but never connects (stuck on "Please wait...").

location / {
    proxy_pass http://127.0.0.1:8501;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
}
